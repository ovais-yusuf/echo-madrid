# SQLAlchemy / Alembic database URL
# Examples:
#   sqlite:///./echo_madrid.db
#   postgresql+psycopg://user:password@localhost:5432/echo_madrid
DATABASE_URL=sqlite:///./echo_madrid.db

# football-data.org v4 API token (never commit a real key)
FOOTBALL_DATA_API_KEY=

# OpenAI API key for Ask Echo (never commit a real key)
OPENAI_API_KEY=
